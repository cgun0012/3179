{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Ways to deal with Mental Health Illness"},
  "width": 560,
  "height": 200,
  "data": {"url": "dealing_with_mental_disorder.csv"},
  
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "Percent",
          "type": "quantitative",
          "title": "Percent (%)",
          "axis": {"format": ".1f", "grid": true}
        },
        "y": {
          "field": "Method",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {"labelLimit": 260}
        },
        "color": {"value": "#4e79a7"},
        "tooltip": [
          {"field": "Method", "title": "Method"},
          {"field": "Percent", "title": "Percentage (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 4},
      "encoding": {
        "x": {"field": "Percent", "type": "quantitative"},
        "y": {"field": "Method", "type": "nominal", "sort": "-x"},
        "text": {"field": "Percent", "type": "quantitative", "format": ".1f"}
      }
    }
  ]
}
