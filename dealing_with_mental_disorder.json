{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Ways to deal with Mental Health Illness"},
  "width": 560,
  "height": 200,
  "data": {"url": "dealing_with_mental_disorder.csv"},

  "transform": [
    {"joinaggregate": [{"op": "max", "field": "Percent", "as": "max_percent"}]}
  ],

  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "x": {"field": "Percent", "type": "quantitative", "title": "Percent (%)"},
        "y": {"field": "Method", "type": "nominal"},
        "strokeWidth": {
          "condition": {"test": "datum.Percent === datum.max_percent", "value": 2},
          "value": 0
        },
        "tooltip": [
          {"field": "Method", "title": "Method"},
          {"field": "Percent", "title": "Percentage (%)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 4},
      "encoding": {
        "x": {"field": "Percent", "type": "quantitative"},
        "y": {"field": "Method", "type": "nominal"},
        "text": {"field": "Percent", "type": "quantitative", "format": ".0f"},
        "fontWeight": {
          "condition": {"test": "datum.Percent === datum.max_percent", "value": "bold"},
          "value": "normal"
        },
        "color": {
          "condition": {"test": "datum.Percent === datum.max_percent", "value": "black"},
          "value": "#333"
        }
      }
    }
  ]
}
