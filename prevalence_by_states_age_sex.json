{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Mental Health Condition Prevalence by State, Sex, and Age Group — Australia",
  "width": 450,
  "height": 420,

  "data": { "url": "prevalence_by_states_age_sex.csv" },

  "params": [
    {
      "name": "stateSel",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "State: ",
        "options": ["All","ACT","NSW","NT","QLD","SA","TAS","VIC","WA"]
      }
    }
  ],

  "transform": [
    { "calculate": "toNumber(datum.percentage)", "as": "pct" },
    { "calculate": "lower(trim(datum.states))", "as": "stateClean" },
    { "calculate": "indexof(datum.diagnosis, 'Has a mental health condition') >= 0", "as": "diagHas" },
    { "calculate": "toNumber(split(datum['age_group'], ' ')[0])", "as": "age_start" },
    { "filter": "datum.diagHas" },
    { "filter": "datum.stateClean != 'australia'" },
    { "filter": "stateSel == 'All' || datum.stateClean == lower(stateSel)" }
  ],

  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "nominal",
          "title": "Age group",
          "axis": { "labelAngle": 0 },
          "sort": { "field": "age_start", "order": "ascending" }
        },
        "y": {
          "aggregate": "sum",
          "field": "pct",
          "type": "quantitative",
          "title": "Prevalence (%)",
          "axis": { "format": ".1f" }
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": "Sex",
          "scale": { "domain": ["Female","Male"], "range": ["#FFC0CB","#87CEFA"] }
        },
        "tooltip": [
          { "field": "states", "title": "State" },
          { "field": "age_group", "title": "Age group" },
          { "field": "sex", "title": "Sex" },
          { "aggregate": "sum", "field": "pct", "title": "Prevalence (%)", "format": ".1f" }
        ]
      }
    },

    
    {
      "transform": [
        { "aggregate": [{ "op": "sum", "field": "pct", "as": "total" }], "groupby": ["age_group","age_start"] },
        { "window": [{ "op": "rank", "as": "r" }], "sort": [{ "field": "total", "order": "descending" }] },
        { "filter": "datum.r == 1" },
        { "calculate": "'Highest total: ' + datum.age_group + ' (' + format(datum.total, '.1f') + '%)'", "as": "label" }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -6,
        "fontWeight": 700
      },
      "encoding": {
        "x": { "field": "age_group", "type": "nominal", "sort": { "field": "age_start", "order": "ascending" } },
        "y": { "field": "total", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#333" }
      }
    }
  ]
}
