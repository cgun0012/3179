{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height":430,
  "title": {
    "text": "Mental illness prevalence — Australia",
    "subtitle": {"expr": "Years"}
  },
  "data": { "url": "au_mental_illness_prevalence_1990_2021.csv" },
  "params": [
    {
      "name": "Years",
      "value": 2021,
      "bind": {"input": "range", "min": 1990, "max": 2021, "step": 1}
    }
  ],
  "transform": [
    { "calculate": "toNumber(datum['Year'])", "as": "yearNum" },
    { "calculate": "toNumber(datum['Percentage'])", "as": "pct" },
    { "filter": "datum.yearNum == Years" }
  ],
  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "x": {
          "field": "Mental Illness",
          "type": "nominal",
          "title": null,
          "sort": "-y",
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "title": "Prevalence (%)",
          "axis": {"format": ".1f"}
        },

        "tooltip": [
          {"field": "Mental Illness"},
          {"field": "yearNum", "title": "Year"},
          {"field": "pct", "title": "Prevalence (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{ "filter": "datum['Mental Illness'] === 'Anxiety Disorders'" }],
      "mark": { "type": "bar" },
      "encoding": {
        "x": { "field": "Mental Illness", "type": "nominal" },
        "y": { "field": "pct", "type": "quantitative" },
        "color": { "value": "#1e40af" }
      }
    },
    {
      "transform": [{ "filter": "datum['Mental Illness'] === 'Depressive Disorders'" }],
      "mark": { "type": "bar" },
      "encoding": {
        "x": { "field": "Mental Illness", "type": "nominal" },
        "y": { "field": "pct", "type": "quantitative" },
        "color": { "value": "#4169E1" }
      }
    },
    {
      "transform": [
        { "filter": "datum['Mental Illness'] === 'Anxiety Disorders'" },
        { "calculate": "'Anxiety: ' + format(datum.pct, '.1f') + '% ' ", "as": "label" }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 10,
        "dy": -10,
        "fontWeight": 700
      },
      "encoding": {
        "x": { "field": "Mental Illness", "type": "nominal" },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#1e40af" }
      }
    },
    {
      "transform": [
        { "filter": "datum['Mental Illness'] === 'Depressive Disorders'" },
        { "calculate": "'Depression: ' + format(datum.pct, '.1f') + '% ' ", "as": "label" }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 10,
        "dy": -10,
        "fontWeight": 700
      },
      "encoding": {
        "x": { "field": "Mental Illness", "type": "nominal" },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value":"#4169E1" }
      }
    }
  ]
}
